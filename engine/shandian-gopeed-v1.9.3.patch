+// Stream 闪电下载：边下边播。按播放顺序优先下最大的那个文件（从头往后，外加文件末尾 8 MB，
+// mp4 的索引常在末尾），靠 anacrolix 的 Reader 预读驱动下载顺序；读到的数据丢弃，文件照常写盘
+func (f *Fetcher) Stream() error {
+	if !f.torrentReady.Load() {
+		return fmt.Errorf("torrent not ready")
+	}
+	files := f.torrent.Files()
+	var target *torrent.File
+	for _, i := range f.meta.Opts.SelectFiles {
+		if i < len(files) && (target == nil || files[i].Length() > target.Length()) {
+			target = files[i]
+		}
+	}
+	if target == nil {
+		return fmt.Errorf("no file")
+	}
+	if !f.streaming.CompareAndSwap(false, true) {
+		return nil
+	}
+	ctx := f.torrentDropCtx
+	go func() {
+		tail := target.NewReader()
+		defer tail.Close()
+		if _, err := tail.Seek(max(0, target.Length()-8<<20), io.SeekStart); err == nil {
+			_, _ = io.Copy(io.Discard, &ctxReader{ctx, tail})
+		}
+	}()
+	go func() {
+		defer f.streaming.Store(false)
+		r := target.NewReader()
+		defer r.Close()
+		r.SetReadahead(48 << 20)
+		r.SetResponsive()
+		_, _ = io.Copy(io.Discard, &ctxReader{ctx, r})
+	}()
+	return nil
+}
+
+// PlayReader 边下边送：最大的那个选中文件的读取器，读到哪儿就优先下哪儿（拖进度条也是），读不到就等
+func (f *Fetcher) PlayReader(ctx context.Context) (io.ReadSeekCloser, string, error) {
+	if !f.torrentReady.Load() {
+		return nil, "", fmt.Errorf("torrent not ready")
+	}
+	files := f.torrent.Files()
+	var target *torrent.File
+	for _, i := range f.meta.Opts.SelectFiles {
+		if i < len(files) && (target == nil || files[i].Length() > target.Length()) {
+			target = files[i]
+		}
+	}
+	if target == nil {
+		return nil, "", fmt.Errorf("no file")
+	}
+	r := target.NewReader()
+	r.SetResponsive()
+	r.SetReadahead(16 << 20)
+	return &ctxReadSeeker{ctx, r}, filepath.Base(target.DisplayPath()), nil
+}
+
+type ctxReadSeeker struct {
+	ctx context.Context
+	r   torrent.Reader
+}
+
+func (c *ctxReadSeeker) Read(p []byte) (int, error)                 { return c.r.ReadContext(c.ctx, p) }
+func (c *ctxReadSeeker) Seek(off int64, whence int) (int64, error) { return c.r.Seek(off, whence) }
+func (c *ctxReadSeeker) Close() error                               { return c.r.Close() }
+
+type ctxReader struct {
+	ctx context.Context
+	r   torrent.Reader
+}
+
+func (c *ctxReader) Read(p []byte) (int, error) { return c.r.ReadContext(c.ctx, p) }
