{
  "manifest_version": 3,
  "name": "闪电全能下载",
  "version": "1.11.0",
  "description": "浏览器里的下载交给闪电全能下载；右键链接可直接用闪电全能下载。",
  "key": "",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "tabs", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["*://*.douyin.com/*"], "js": ["douyin-hook.js"], "run_at": "document_start", "world": "MAIN" }],
  "action": { "default_title": "闪电全能下载", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
