{
  "manifest_version": 3,
  "name": "闪电下载",
  "version": "1.1.0",
  "description": "浏览器里的下载交给闪电下载；右键链接可直接用闪电下载。",
  "key": "",
  "permissions": ["downloads", "contextMenus", "cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "闪电下载：接管下载已开启（点击切换）", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
