diff --git a/internal/shandian/shandian.go b/internal/shandian/shandian.go
new file mode 100644
index 0000000..496faca
--- /dev/null
+++ b/internal/shandian/shandian.go
@@ -0,0 +1,78 @@
+// Package shandian 是闪电下载对 Gopeed v1.9.3 的补丁：
+//   - BT 块完成记录落盘（原版用 .part 文件时只记内存，内核一重启就整片重新校验）
+//   - 全局下载限速（BT 和 HTTP 共用一个限速器，配置 extra.shandianDownloadLimit，单位 KB/s，0 为不限）
+package shandian
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"path/filepath"
+	"sync"
+
+	"github.com/anacrolix/torrent/storage"
+	"golang.org/x/time/rate"
+)
+
+// Limiter 全局下载限速器，默认不限
+var Limiter = rate.NewLimiter(rate.Inf, 1<<20)
+
+func SetDownloadLimit(kbps int) {
+	if kbps <= 0 {
+		Limiter.SetLimit(rate.Inf)
+		return
+	}
+	bps := kbps * 1024
+	Limiter.SetBurst(max(bps, 256<<10))
+	Limiter.SetLimit(rate.Limit(bps))
+}
+
+// ApplyExtra 从下载配置的 extra 里读限速
+func ApplyExtra(extra map[string]any) {
+	v, _ := extra["shandianDownloadLimit"].(float64)
+	SetDownloadLimit(int(v))
+}
+
+// Wait 读到 n 字节后按限速等待；不限速时立刻返回
+func Wait(n int) {
+	if n <= 0 || Limiter.Limit() == rate.Inf {
+		return
+	}
+	for n > 0 {
+		c := min(n, Limiter.Burst())
+		_ = Limiter.WaitN(context.Background(), c)
+		n -= c
+	}
+}
+
+var (
+	pcOnce sync.Once
+	pc     storage.PieceCompletion
+)
+
+// 所有种子共用一个落盘的块完成记录；包一层不让单个种子关闭时把它关掉
+type sharedCompletion struct{ storage.PieceCompletion }
+
+func (sharedCompletion) Close() error { return nil }
+
+// PieceCompletion 放在内核工作目录的 data/piece-completion 下（App 把工作目录设为内核目录）
+func PieceCompletion() storage.PieceCompletion {
+	pcOnce.Do(func() {
+		dir, _ := os.Getwd()
+		d := filepath.Join(dir, "data", "piece-completion")
+		_ = os.MkdirAll(d, 0o700)
+		if c, err := storage.NewBoltPieceCompletion(d); err == nil {
+			pc = sharedCompletion{c}
+		} else {
+			pc = storage.NewMapPieceCompletion()
+		}
+	})
+	return pc
+}
+
+// PlayKey 播放地址里的密钥：token 和任务 id 派生，不同任务不同，泄露也拿不到 token
+func PlayKey(token, id string) string {
+	sum := sha256.Sum256([]byte("shandian-play:" + token + ":" + id))
+	return hex.EncodeToString(sum[:])[:24]
+}
