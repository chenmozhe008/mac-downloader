index 0000000..d769291
--- /dev/null
+++ b/internal/protocol/http/shandian_test.go
@@ -0,0 +1,87 @@
+package http
+
+import (
+	"net"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/GopeedLab/gopeed/internal/test"
+)
+
+// 闪电下载补丁的测试
+
+// 新片厂 xpccdn：不带 Range 回 403，带 Range 才 206
+func TestShandian_Range403(t *testing.T) {
+	fs := test.StartTestFileServer() // 生成测试文件；Close 时会删掉它
+	defer fs.Close()
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !strings.HasPrefix(r.Header.Get("Range"), "bytes=") {
+			w.WriteHeader(403)
+			return
+		}
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	downloadNormal(ln, 4, t)
+}
+
+// 下载中途服务器一直回 429：不能永远「下载中」，要在放弃时限后报错
+func TestShandian_Persistent429Fails(t *testing.T) {
+	old := shandianExemptGiveUp
+	shandianExemptGiveUp = 5 * time.Second
+	defer func() { shandianExemptGiveUp = old }()
+	fs := test.StartTestFileServer()
+	defer fs.Close()
+	var n atomic.Int32
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if n.Add(1) > 1 { // 只有解析那一下正常，之后一律 429
+			w.WriteHeader(429)
+			return
+		}
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	f := downloadReady(ln, 4, t)
+	// 解析的响应体也会被用来下载，掐掉它模拟中途断开
+	f.(*Fetcher).resolveRespLock.Lock()
+	if f.(*Fetcher).resolveResp != nil {
+		f.(*Fetcher).resolveResp.Body.Close()
+	}
+	f.(*Fetcher).resolveRespLock.Unlock()
+	if err := f.Start(); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- f.Wait() }()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("一直 429 却报告完成")
+		}
+	case <-time.After(60 * time.Second):
+		t.Fatal("一直 429 时任务卡住不报错")
+	}
+}
+
+// 偶尔 429（像维基限流，约一半请求被拒）：退避重试后应能下完
+func TestShandian_Intermittent429Completes(t *testing.T) {
+	fs := test.StartTestFileServer()
+	defer fs.Close()
+	var n atomic.Int32
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if n.Add(1)%2 == 0 {
+			w.WriteHeader(429)
+			return
+		}
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	downloadNormal(ln, 8, t)
+}
+
